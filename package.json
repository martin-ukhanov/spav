{
	"name": "spav-js",
	"description": "Spatial Navigation for the Modern Web",
	"keywords": [
		"spav",
		"spav-js",
		"spatial",
		"navigation",
		"keyboard",
		"focus",
		"accessibility"
	],
	"version": "0.1.7",
	"author": "martin-ukhanov",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/martin-ukhanov/spav.git"
	},
	"homepage": "https://github.com/martin-ukhanov/spav",
	"type": "module",
	"files": [
		"dist"
	],
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev:playground": "pnpm --filter playground dev",
		"build": "tsdown",
		"prepublishOnly": "pnpm run build",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.7.0",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.3",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"prettier": "^3.8.4",
		"publint": "^0.3.21",
		"tsdown": "^0.22.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0"
	}
}
